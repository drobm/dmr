# Copy to .env.local for local work. NEVER commit real values —
# .env* is gitignored. On Vercel these are set in
# Project > Settings > Environment Variables.

# --- AI plan generation -------------------------------------
# From console.anthropic.com. Without it the app still works and
# serves the built-in fallback plans.
ANTHROPIC_API_KEY=

# --- Database -----------------------------------------------
# Injected automatically when you add Postgres from the Vercel
# Marketplace. Only set this by hand for local testing.
POSTGRES_URL=

# --- Sessions -----------------------------------------------
# Signs the login cookie. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out. Never share it.
AUTH_SECRET=

# --- Email (Resend, via Vercel Marketplace) -----------------
RESEND_API_KEY=
# Where new-lead alerts go:
LEAD_ALERT_TO=
# Must be a domain verified in Resend. Until then, the default
# onboarding@resend.dev works but only delivers to your own address.
EMAIL_FROM=Pain Relief Guide <hello@dynamicmusclerecovery.com>

# --- Site ----------------------------------------------------
# Used to build magic-link URLs. Set once the domain is live.
PUBLIC_BASE_URL=https://app.dynamicmusclerecovery.com
